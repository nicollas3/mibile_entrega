@page "/carrinho"
@inherits PageBase
@inject NavigationManager Nav
@inject Microsoft.JSInterop.IJSRuntime JS
<PageTitle>Seu carrinho · Brasa</PageTitle><p class="eyebrow">SÓ FALTA UM PASSO</p><h1>À sua mesa.</h1><Feedback Error="@Error" Message="@Message" Busy="@Busy"/>
@if(Api.Session==null){<p><a href="/entrar">Entre para montar seu pedido.</a></p>}else{
<button class="quiet" disabled="@Busy" @onclick="Clear">Esvaziar carrinho</button>
@if(cart?.Items.Count>0){<div class="grid two"><section class="card"><h2>Seu pedido</h2>@foreach(var line in cart.Items){<div class="order-line"><div><strong>@line.Quantity × @line.Name</strong><p class="small muted">@line.Notes @string.Join(", ",line.Options.Select(x=>x.Name))</p></div><strong>@Money((line.UnitPrice+line.Options.Sum(x=>x.Price))*line.Quantity)</strong><button class="quiet small" @onclick="()=>Remove(line.ProductId)">Remover</button></div>}
<label>Cupom<input @bind="coupon" maxlength="30" placeholder="Ex.: BEMVINDO"/></label><button class="quiet" disabled="@Busy" @onclick="Load">Aplicar cupom</button>
@if(cart.Totals is {} t){<dl class="totals"><div><dt>Subtotal</dt><dd>@Money(t.Subtotal)</dd></div><div><dt>Desconto</dt><dd>− @Money(t.Discount)</dd></div><div><dt>Entrega</dt><dd>@Money(t.DeliveryFee)</dd></div><div><dt>Taxa de serviço</dt><dd>@Money(t.ServiceFee)</dd></div><div class="total"><dt>Total</dt><dd>@Money(t.Total)</dd></div></dl>}
<label>Endereço<select @bind="addressId"><option value="@Guid.Empty">Selecione um endereço</option>@foreach(var a in addresses){<option value="@a.Id">@a.Label — @a.Formatted</option>}</select></label><label>Pagamento de demonstração<select @bind="payment"><option value="demo-approved">Simular aprovação — não cobra</option><option value="demo-declined">Simular recusa — não cobra</option><option value="demo-pending">Aguardar webhook de demonstração</option></select></label><button disabled="@(Busy||addressId==Guid.Empty)" @onclick="Checkout">Confirmar pedido de demonstração</button><p class="small muted">Nenhum cartão ou dado financeiro é necessário. Em caso de timeout, tente novamente sem alterar os dados.</p></section>
<section class="card"><h2>Novo endereço</h2><form class="form-grid" @onsubmit="AddAddress" @onsubmit:preventDefault><label>Nome do endereço<input required @bind="label"/></label><label>Rua<input required @bind="street"/></label><label>Número<input required @bind="number"/></label><label>Bairro<input required @bind="district"/></label><label>Cidade<input required @bind="city"/></label><label>UF<input required maxlength="2" @bind="state"/></label><label>CEP (8 números)<input required pattern="[0-9]{8}" @bind="postal"/></label><label>Complemento<input @bind="complement"/></label><label>Referência<input @bind="reference"/></label><label>Latitude<input type="number" step="any" min="-90" max="90" @bind="latitude"/></label><label>Longitude<input type="number" step="any" min="-180" max="180" @bind="longitude"/></label><p class="small muted">Informe coordenadas reais obtidas no seu mapa. A geocodificação ainda exige um provedor externo. A área é calculada por distância em linha reta.</p><button disabled="@Busy">Salvar endereço</button></form></section></div>
}else if(cart!=null){<div class="empty">Seu carrinho está esperando um bom sabor. <a href="/explorar">Explorar cozinhas</a></div>}}
@code{
 CartDto? cart;List<AddressDto> addresses=[];string coupon="",payment="demo-approved",key=Guid.NewGuid().ToString("N"),requestFingerprint="";Guid addressId;
 string label="Casa",street="",number="",district="",city="São Paulo",state="SP",postal="",complement="",reference="";double latitude=-23.5505,longitude=-46.6333;
 protected override async Task OnInitializedAsync(){if(Api.Session!=null)await Load();}
 async Task Load()=>await Run(async()=>{cart=await Api.Get<CartDto>("api/cart?coupon="+Uri.EscapeDataString(coupon));addresses=await Api.Get<List<AddressDto>>("api/me/addresses");if(addressId==Guid.Empty&&addresses.Count>0)addressId=addresses[0].Id;});
 async Task Clear(){if(!await JS.InvokeAsync<bool>("confirm","Esvaziar o carrinho?"))return;await Run(async()=>{await Api.Delete("api/cart");cart=new(null,[],null);key=Guid.NewGuid().ToString("N");});}
 async Task Remove(Guid id){await Run(async()=>{var lines=cart!.Items.Where(x=>x.ProductId!=id).Select(x=>new CartLine(x.ProductId,x.Quantity,x.Notes,x.Options.Select(o=>o.Id).ToList())).ToList();cart=await Api.Put<CartDto>("api/cart",new CartInput(lines));key=Guid.NewGuid().ToString("N");});}
 async Task Checkout()=>await Run(async()=>{var fingerprint=$"{addressId}|{coupon}|{payment}";if(requestFingerprint.Length>0&&requestFingerprint!=fingerprint)key=Guid.NewGuid().ToString("N");requestFingerprint=fingerprint;var o=await Api.Post<OrderDto>("api/orders",new CheckoutRequest(addressId,coupon,payment),key);Nav.NavigateTo($"/pedido/{o.Id}");});
 async Task AddAddress(){await Run(async()=>{var a=await Api.Post<AddressDto>("api/me/addresses",new AddressInput(label,street,number,district,city,state.ToUpperInvariant(),postal,complement,reference,latitude,longitude));addresses.Add(a);addressId=a.Id;Message="Endereço salvo.";});}
}
