@page "/restaurante"
@inherits PageBase
@implements IAsyncDisposable
@inject IJSRuntime JS
<PageTitle>Meu restaurante · Brasa</PageTitle><p class="eyebrow">SUA COZINHA, SEU RITMO</p><h1>Vamos preparar um bom dia.</h1><Feedback Error="@Error" Message="@Message" Busy="@Busy"/>
@if(Api.Session==null){<a href="/entrar">Entre com a conta da sua loja.</a>}else if(stores.Count==0&&!Busy){<p class="empty">Sua conta não está vinculada a um restaurante. Solicite o vínculo à administração.</p>}else{
<div class="actions"><label>Restaurante<select @bind="storeId" @bind:after="LoadStore">@foreach(var s in stores){<option value="@s.RestaurantId">@s.Name</option>}</select></label><button class="quiet" disabled="@Busy" @onclick="LoadStore">Atualizar operação</button><label class="inline"><input type="checkbox" @bind="sound"/> Alerta sonoro de novos eventos</label><span class="muted small" role="status">@realtime</span></div>
<Stats Report="report"/>
<div class="tabs" role="navigation" aria-label="Áreas da loja">@foreach(var item in new[]{"Pedidos","Cardápio","Configurações","Equipe"}){<button class="@(tab==item?"":"quiet")" @onclick="()=>tab=item">@item</button>}</div>
@if(tab=="Pedidos"&&Allowed(1)){
<div class="grid three">@foreach(var o in orders?.Items??[]){<article class="card"><div class="section-heading"><a href="@($"/pedido/{o.Id}")">#@o.Id.ToString()[..8]</a><span class="badge">@Status(o.Status)</span></div><h3>@o.Items.Sum(x=>x.Quantity) itens · @Money(o.Prices.Total)</h3><p class="small muted">@o.CreatedAt.ToOffset(TimeSpan.FromHours(-3)).ToString("dd/MM HH:mm")</p>@foreach(var line in o.Items){<p>@line.Quantity × @line.Name <small>@line.Notes</small></p>}
<div class="actions">@if(o.Status=="CourierAssigned"&&!o.HandoverConfirmed){<button disabled="@Busy" @onclick="()=>Handover(o)">Confirmar retirada pelo entregador</button>}@if(o.Status=="SentToRestaurant"){<button disabled="@Busy" @onclick='()=>Transition(o,"Accepted")'>Aceitar</button><button class="danger" disabled="@Busy" @onclick='()=>Transition(o,"Rejected")'>Recusar</button>}@if(o.Status=="Accepted"){<button disabled="@Busy" @onclick='()=>Transition(o,"Preparing")'>Iniciar preparo</button>}@if(o.Status=="Preparing"){<button disabled="@Busy" @onclick='()=>Transition(o,"Ready")'>Pronto para retirada</button>}</div></article>}</div><label>Justificativa para recusa<input @bind="reason" maxlength="500" placeholder="Informe antes de recusar um pedido"/></label><div class="actions"><button class="quiet" disabled="@(orderPage<=1||Busy)" @onclick="PrevOrders">Anteriores</button><span>Página @(orderPage)</span><button class="quiet" disabled="@(orderPage*50>=(orders?.Total??0)||Busy)" @onclick="NextOrders">Próximos</button></div>
}else if(tab=="Cardápio"&&Allowed(2)){
<div class="grid two"><section><h2>Seu cardápio</h2>@foreach(var p in products){<article class="card order-line"><div><span class="eyebrow">@p.Category</span><h3>@p.Name</h3><span>@Money(p.Price) · @(p.Available?"Disponível":"Esgotado")</span></div><button class="quiet" @onclick="()=>EditProduct(p)">Editar</button></article>}<button class="quiet" @onclick="NewProduct">Novo produto</button></section>
<form class="card form-grid" @onsubmit="SaveProduct" @onsubmit:preventDefault><h2>@(productId.HasValue?"Editar produto":"Novo sabor")</h2><label>Nome<input required @bind="productName"/></label><label>Categoria<input required @bind="productCategory" list="categories"/></label><datalist id="categories">@foreach(var c in products.Select(x=>x.Category).Distinct()){<option value="@c"/>}</datalist><label>Descrição<textarea @bind="productDescription"/></label><label>Alérgenos informados<textarea @bind="allergens"/></label><label>URL HTTPS da foto<input type="url" @bind="photo"/></label><label>Preço (R$)<input required type="number" min="0.01" step="0.01" @bind="productPrice"/></label><label class="inline"><input type="checkbox" @bind="available"/> Disponível para venda</label><label>Adicionais (um por linha: Nome|Preço)<textarea @bind="optionsText" placeholder="Queijo|4,00"/></label><button disabled="@Busy">Salvar produto</button></form></div>
}else if(tab=="Configurações"&&Allowed(4)){
<form class="card form-grid settings-form" @onsubmit="SaveSettings" @onsubmit:preventDefault><h2>De portas abertas</h2><label>Nome<input required @bind="storeName"/></label><label>Categoria<input required @bind="storeCategory"/></label><label>Descrição<textarea @bind="storeDescription"/></label><label>Endereço<input required @bind="storeAddress"/></label><label>Horário de funcionamento<input required @bind="hours"/></label><label>Situação<select @bind="status"><option value="Open">Aberta</option><option value="Closed">Fechada</option><option value="Paused">Pausada</option><option value="Unavailable">Temporariamente indisponível</option></select></label><label>Preparo estimado (min)<input type="number" min="5" max="180" @bind="prep"/></label><label>Taxa de entrega (R$)<input type="number" min="0" step="0.01" @bind="deliveryFee"/></label><label>Pedido mínimo (R$)<input type="number" min="0" step="0.01" @bind="minimum"/></label><label>Raio aproximado (km)<input type="number" min="0.1" max="100" step="0.1" @bind="radius"/></label><label>Latitude<input type="number" step="any" @bind="latitude"/></label><label>Longitude<input type="number" step="any" @bind="longitude"/></label><button disabled="@Busy">Salvar dados da loja</button></form>
}else if(tab=="Equipe"&&Allowed(16)){
<div class="grid two"><section class="card"><h2>Quem faz acontecer</h2>@foreach(var m in members){<p><strong>@m.Name</strong><br/>@m.Email · Permissões: @PermissionsText(m.Permissions)</p>}</section><form class="card form-grid" @onsubmit="SaveMember" @onsubmit:preventDefault><h2>Acesso por função</h2><label>Email da conta cadastrada<input type="email" required @bind="memberEmail"/></label><label class="inline"><input type="checkbox" @bind="pOrders"/> Pedidos</label><label class="inline"><input type="checkbox" @bind="pMenu"/> Cardápio</label><label class="inline"><input type="checkbox" @bind="pSettings"/> Configurações</label><label class="inline"><input type="checkbox" @bind="pReports"/> Relatórios</label><label class="inline"><input type="checkbox" @bind="pStaff"/> Gerenciar equipe</label><button disabled="@Busy">Atualizar permissões</button><p class="small muted">Sem permissões marcadas, o acesso à loja é removido.</p></form></div>
}else{<div class="empty">Seu perfil não permite acessar esta área.</div>}}
@code{
 List<StoreAccessDto> stores=[];List<ProductDto> products=[];List<MemberDto> members=[];PageDto<OrderDto>? orders;ReportDto? report;Guid storeId;string tab="Pedidos",reason="",realtime="Atualização manual disponível";HubConnection? hub;bool sound;int orderPage=1;
 string storeName="",storeCategory="",storeDescription="",storeAddress="",hours="",status="Open";int prep=30;decimal deliveryFee,minimum;double radius=8,latitude,longitude;
 Guid? productId;string productName="",productCategory="",productDescription="",allergens="",photo="",optionsText="";decimal productPrice;bool available=true;
 string memberEmail="";bool pOrders,pMenu,pSettings,pReports,pStaff;
 static string PermissionsText(int value)=>string.Join(", ",new[]{(1,"pedidos"),(2,"cardápio"),(4,"configurações"),(8,"relatórios"),(16,"equipe")}.Where(x=>(value&x.Item1)!=0).Select(x=>x.Item2));
 bool Allowed(int flag)=>stores.FirstOrDefault(x=>x.RestaurantId==storeId) is {} s&&(s.Permissions&flag)==flag;
 protected override async Task OnInitializedAsync(){if(Api.Session==null)return;await Run(async()=>{stores=await Api.Get<List<StoreAccessDto>>("api/stores");storeId=stores.FirstOrDefault()?.RestaurantId??Guid.Empty;});if(storeId!=Guid.Empty)await LoadStore();}
 async Task LoadStore(){if(storeId==Guid.Empty)return;await Run(async()=>{if(Allowed(1))orders=await Api.Get<PageDto<OrderDto>>($"api/stores/{storeId}/orders?page={orderPage}");if(Allowed(8))report=await Api.Get<ReportDto>($"api/stores/{storeId}/report");products=await Api.Get<List<ProductDto>>($"api/restaurants/{storeId}/menu");if(Allowed(16))members=await Api.Get<List<MemberDto>>($"api/stores/{storeId}/members");var r=await Api.Get<RestaurantDto>($"api/restaurants/{storeId}");storeName=r.Name;storeCategory=r.Category;storeDescription=r.Description;storeAddress=r.Address;hours=r.Hours;status=r.Status;prep=r.PreparationMinutes;deliveryFee=r.DeliveryFee;minimum=r.MinimumOrder;latitude=r.Latitude;longitude=r.Longitude;radius=r.RadiusKm;});if(Allowed(1)&&hub==null){try{hub=await Api.Connect(OnChanged);await hub.InvokeAsync("JoinStore",storeId);hub.Reconnected+=async connection=>{await hub.InvokeAsync("JoinStore",storeId);await InvokeAsync(LoadStore);};realtime="Pedidos em tempo real conectados";}catch(Exception ex)when(ex is HttpRequestException or HubException or InvalidOperationException){realtime="Tempo real indisponível; use Atualizar.";}}else if(hub?.State==HubConnectionState.Connected&&Allowed(1))await hub.InvokeAsync("JoinStore",storeId);}
 void OnChanged(Guid id){_=InvokeAsync(async()=>{await LoadStore();if(sound)await JS.InvokeVoidAsync("brasaAlert");StateHasChanged();});}
 async Task Transition(OrderDto o,string next){if(next=="Rejected"&&!await JS.InvokeAsync<bool>("confirm","Recusar o pedido e registrar a justificativa?"))return;await Run(async()=>{await Api.Post<OrderDto>($"api/orders/{o.Id}/transition",new TransitionRequest(next,o.Version,reason));orders=await Api.Get<PageDto<OrderDto>>($"api/stores/{storeId}/orders?page={orderPage}");Message="Pedido atualizado.";});}
 async Task Handover(OrderDto o){if(!await JS.InvokeAsync<bool>("confirm","Confirmar a entrega do pedido ao entregador presente na loja?"))return;await Run(async()=>{await Api.Post<OrderDto>($"api/orders/{o.Id}/handover");orders=await Api.Get<PageDto<OrderDto>>($"api/stores/{storeId}/orders?page={orderPage}");});}
 async Task PrevOrders(){orderPage--;await LoadStore();}async Task NextOrders(){orderPage++;await LoadStore();}
 void NewProduct(){productId=null;productName="";productCategory="";productDescription="";allergens="";photo="";productPrice=0;available=true;optionsText="";}
 void EditProduct(ProductDto p){productId=p.Id;productName=p.Name;productCategory=p.Category;productDescription=p.Description;allergens=p.Allergens;photo=p.ImageUrl??"";productPrice=p.Price;available=p.Available;optionsText=string.Join('\n',p.Options.Select(x=>$"{x.Name}|{x.Price.ToString(Brazil)}"));}
 async Task SaveProduct()=>await Run(async()=>{var options=new List<OptionInput>();foreach(var line in optionsText.Split('\n',StringSplitOptions.RemoveEmptyEntries)){var parts=line.Split('|');if(parts.Length!=2||!decimal.TryParse(parts[1],System.Globalization.NumberStyles.Number,Brazil,out var amount)){Error="Revise os adicionais: Nome|Preço, um por linha.";return;}options.Add(new(parts[0],amount));}var input=new ProductInput(productName,productDescription,productCategory,allergens,string.IsNullOrWhiteSpace(photo)?null:photo,productPrice,available,options);if(productId.HasValue)await Api.Put<object>($"api/stores/{storeId}/products/{productId}",input);else await Api.Post<object>($"api/stores/{storeId}/products",input);products=await Api.Get<List<ProductDto>>($"api/restaurants/{storeId}/menu");Message="Cardápio atualizado.";});
 async Task SaveSettings()=>await Run(async()=>{await Api.Put<object>($"api/stores/{storeId}",new RestaurantInput(storeName,storeDescription,storeCategory,storeAddress,latitude,longitude,radius,hours,status,prep,deliveryFee,minimum));Message="Loja atualizada.";});
 async Task SaveMember()=>await Run(async()=>{int permissions=(pOrders?1:0)|(pMenu?2:0)|(pSettings?4:0)|(pReports?8:0)|(pStaff?16:0);await Api.Put<object>($"api/stores/{storeId}/members",new MemberInput(memberEmail,permissions));members=await Api.Get<List<MemberDto>>($"api/stores/{storeId}/members");Message="Permissões atualizadas.";});
 public async ValueTask DisposeAsync(){if(hub!=null)await hub.DisposeAsync();}
}
