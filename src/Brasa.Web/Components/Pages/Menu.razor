@page "/cozinha/{Id:guid}"
@inherits PageBase
<PageTitle>@(restaurant?.Name??"Cozinha") · Brasa</PageTitle><Feedback Error="@Error" Message="@Message" Busy="@Busy"/>
@if(restaurant!=null){<p class="eyebrow">@restaurant.Category</p><h1>@restaurant.Name</h1><p class="lead">@restaurant.Description</p><div class="meta"><span>@Status(restaurant.Status)</span><span>~@restaurant.PreparationMinutes min (estimativa)</span><span>Entrega @Money(restaurant.DeliveryFee)</span><span>Mínimo @Money(restaurant.MinimumOrder)</span></div><p class="muted">@restaurant.Hours · @restaurant.Address</p><a class="button" href="/carrinho">Ver meu carrinho ↗</a>
<section class="grid two menu-grid">@foreach(var p in products){<article class="card product"><div><span class="eyebrow">@p.Category</span><h2>@p.Name</h2><p>@p.Description</p><p class="small muted">Alérgenos informados pela loja: @p.Allergens</p><strong class="price">@Money(p.Price)</strong></div>
@if(p.ImageUrl!=null){<img class="product-photo" src="@p.ImageUrl" alt="@p.Name" loading="lazy"/>}
<div class="product-controls">@foreach(var option in p.Options){<label class="inline"><input type="checkbox" checked="@selected[p.Id].Contains(option.Id)" @onchange="e=>Select(p.Id,option.Id,(bool)e.Value!)"/> @option.Name (+@Money(option.Price))</label>}
<label>Observações<textarea maxlength="500" @bind="notes[p.Id]" placeholder="Algo que a cozinha deve saber?"/></label><label>Quantidade<input type="number" min="1" max="50" @bind="quantities[p.Id]"/></label><button disabled="@(Busy||!p.Available||restaurant.Status!="Open")" @onclick="()=>Add(p)">@(p.Available?"Adicionar ao carrinho":"Esgotado")</button></div></article>}</section>
<h2>Quem já provou</h2>@if(reviews.Count==0){<p class="muted">Esta cozinha ainda não recebeu avaliações.</p>}@foreach(var v in reviews){<div class="card"><strong>@v.RestaurantRating ★</strong><p>@v.Comment</p></div>}}
@code{
 [Parameter]public Guid Id{get;set;}RestaurantDto? restaurant;List<ProductDto> products=[];List<ReviewDto> reviews=[];readonly Dictionary<Guid,int> quantities=[];readonly Dictionary<Guid,string> notes=[];readonly Dictionary<Guid,HashSet<Guid>> selected=[];
 protected override async Task OnParametersSetAsync()=>await Run(async()=>{restaurant=await Api.Get<RestaurantDto>($"api/restaurants/{Id}");products=await Api.Get<List<ProductDto>>($"api/restaurants/{Id}/menu");reviews=await Api.Get<List<ReviewDto>>($"api/restaurants/{Id}/reviews");foreach(var p in products){quantities[p.Id]=1;notes[p.Id]="";selected[p.Id]=[];}});
 void Select(Guid p,Guid option,bool value){if(value)selected[p].Add(option);else selected[p].Remove(option);}
 async Task Add(ProductDto p)=>await Run(async()=>{if(Api.Session==null){Error="Entre na sua conta de cliente para adicionar itens.";return;}var cart=await Api.Get<CartDto>("api/cart");if(cart.RestaurantId.HasValue&&cart.RestaurantId!=Id){Error="O carrinho contém itens de outra loja. Esvazie-o na página do carrinho antes de trocar.";return;}var lines=cart.Items.Where(x=>x.ProductId!=p.Id).Select(x=>new CartLine(x.ProductId,x.Quantity,x.Notes,x.Options.Select(o=>o.Id).ToList())).ToList();lines.Add(new(p.Id,quantities[p.Id],notes[p.Id],selected[p.Id].ToList()));await Api.Put<CartDto>("api/cart",new CartInput(lines));Message="Item adicionado. Você pode continuar escolhendo ou abrir o carrinho.";});
}
