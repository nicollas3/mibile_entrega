@page "/pedido/{Id:guid}"
@inherits PageBase
@implements IAsyncDisposable
@inject IJSRuntime JS
<PageTitle>Pedido · Brasa</PageTitle><p class="eyebrow">CUIDADO EM CADA ETAPA</p><h1>Pedido #@Id.ToString()[..8]</h1><Feedback Error="@Error" Message="@Message" Busy="@Busy"/>
@if(Api.Session==null){<a href="/entrar">Entre para acompanhar.</a>}else{<div class="actions"><button class="quiet" @onclick="Load" disabled="@Busy">Atualizar</button><span class="muted small">@realtime</span></div>}
@if(order!=null){<div class="grid two"><section class="card"><span class="badge">@Status(order.Status)</span><h2>@order.RestaurantName</h2><p>@order.Address</p>@foreach(var item in order.Items){<div class="order-line"><span>@item.Quantity × @item.Name <small>@item.Notes</small></span><strong>@Money((item.UnitPrice+item.Options.Sum(x=>x.Price))*item.Quantity)</strong></div>}
<dl class="totals"><div><dt>Subtotal</dt><dd>@Money(order.Prices.Subtotal)</dd></div><div><dt>Desconto</dt><dd>@Money(order.Prices.Discount)</dd></div><div><dt>Entrega</dt><dd>@Money(order.Prices.DeliveryFee)</dd></div><div><dt>Serviço</dt><dd>@Money(order.Prices.ServiceFee)</dd></div><div class="total"><dt>Total</dt><dd>@Money(order.Prices.Total)</dd></div></dl><p class="small muted">Pagamento: @order.PaymentMethod (demonstração). Reembolso: @Status(order.RefundStatus) · @Money(order.Refunded).</p>
@if(order.Status is "AwaitingPayment" or "SentToRestaurant" or "Accepted" || IsAdmin){<label>Motivo de cancelamento<input @bind="reason" minlength="3" maxlength="500"/></label><button class="danger" disabled="@Busy" @onclick="Cancel">Solicitar cancelamento</button>}
@if(IsAdmin){<h3>Reembolso de demonstração</h3><label>Valor (R$)<input type="number" step="0.01" @bind="refund"/></label><label>Justificativa<input @bind="refundReason"/></label><button class="quiet" disabled="@Busy" @onclick="Refund">Registrar reembolso</button>}
</section><section class="card"><h2>O caminho do seu pedido</h2><ol class="timeline">@foreach(var e in events){<li><strong>@Status(e.Next)</strong><span>@e.At.ToOffset(TimeSpan.FromHours(-3)).ToString("dd/MM HH:mm") @e.Reason</span></li>}</ol><h3>Entrega</h3><p>@Status(tracking?.Stage??"Aguardando entregador")</p>
@if(tracking?.Latitude is double lat&&tracking.Longitude is double lon){<p>Última localização informada: @tracking.At?.ToOffset(TimeSpan.FromHours(-3)).ToString("HH:mm:ss")</p><a target="_blank" rel="noopener noreferrer" href="@FormattableString.Invariant($"https://www.google.com/maps/search/?api=1&query={lat},{lon}")">Abrir localização no mapa</a>}else{<p class="muted">Sem localização recente. O pedido continua acessível mesmo sem GPS.</p>}
@if(order.Status=="Delivered"){<h3>Como foi a experiência?</h3><label>Restaurante (1 a 5)<input type="number" min="1" max="5" @bind="storeRating"/></label><label>Entrega (1 a 5)<input type="number" min="1" max="5" @bind="courierRating"/></label><label>Comentário<textarea maxlength="1000" @bind="comment"/></label><button disabled="@Busy" @onclick="Review">Enviar avaliação</button>}
<a href="/suporte">Precisa de ajuda ou deseja corrigir uma entrega? Abra uma ocorrência.</a></section></div>}
@code{
 [Parameter]public Guid Id{get;set;}OrderDto? order;TrackingDto? tracking;List<OrderEventDto> events=[];HubConnection? hub;string realtime="Atualização manual disponível",reason="",refundReason="",comment="",refundKey=Guid.NewGuid().ToString("N");decimal refund;int storeRating=5,courierRating=5;bool IsAdmin=>Api.Session?.User.Roles.Contains("Administrador")==true;
 protected override async Task OnParametersSetAsync(){if(Api.Session==null)return;await Load();try{hub=await Api.Connect(changed=>{_ = InvokeAsync(Load);},changed=>{_ = InvokeAsync(Load);});await hub.InvokeAsync("JoinOrder",Id);hub.Reconnected+=async _=>{await hub.InvokeAsync("JoinOrder",Id);await InvokeAsync(Load);};realtime="Atualização em tempo real conectada";}catch(Exception ex)when(ex is HttpRequestException or HubException or InvalidOperationException){realtime="Conexão em tempo real indisponível. Use Atualizar.";}}
 async Task Load()=>await Run(async()=>{order=await Api.Get<OrderDto>($"api/orders/{Id}");events=await Api.Get<List<OrderEventDto>>($"api/orders/{Id}/events");tracking=await Api.Get<TrackingDto>($"api/orders/{Id}/tracking");});
 async Task Cancel(){if(!await JS.InvokeAsync<bool>("confirm","Confirmar a solicitação de cancelamento?"))return;await Run(async()=>order=await Api.Post<OrderDto>($"api/orders/{Id}/cancel",new ReasonRequest(reason)));await Load();}
 async Task Review()=>await Run(async()=>{await Api.Post<object>($"api/orders/{Id}/review",new ReviewInput(storeRating,courierRating,comment));Message="Obrigado pela avaliação!";});
 async Task Refund(){if(!await JS.InvokeAsync<bool>("confirm","Registrar este reembolso fictício?"))return;await Run(async()=>{order=await Api.Post<OrderDto>($"api/orders/{Id}/refund",new RefundInput(refund,refundReason),refundKey);refundKey=Guid.NewGuid().ToString("N");Message="Reembolso de demonstração registrado.";});}
 public async ValueTask DisposeAsync(){if(hub!=null)await hub.DisposeAsync();}
}
