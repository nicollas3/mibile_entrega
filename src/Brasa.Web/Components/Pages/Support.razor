@page "/suporte"
@inherits PageBase
<PageTitle>Central de ajuda · Brasa</PageTitle><p class="eyebrow">VAMOS RESOLVER JUNTOS</p><h1>Conte com a gente.</h1><Feedback Error="@Error" Message="@Message" Busy="@Busy"/>
@if(Api.Session==null){<a href="/entrar">Entre para solicitar atendimento.</a>}else{<section class="grid two"><form class="card form-grid" @onsubmit="Create" @onsubmit:preventDefault><h2>Abrir uma solicitação</h2><label>Identificador do pedido (opcional)<input @bind="orderId"/></label><label>Assunto<select @bind="category"><option>Ajuda com pedido</option><option>Cancelamento após preparo</option><option>Entrega incorreta</option><option>Problema na entrega</option><option>Privacidade: acesso, correção ou exclusão</option></select></label><label>O que aconteceu?<textarea required minlength="5" maxlength="2000" @bind="description"/></label><button disabled="@Busy">Enviar solicitação</button><p class="small muted">Usamos estes dados para resolver sua solicitação. Não envie senhas nem dados de cartão. Solicitações de exclusão são analisadas conforme os prazos legais de retenção.</p></form>
<div><button class="quiet" @onclick="Load" disabled="@Busy">Atualizar solicitações</button>@foreach(var t in tickets?.Items??[]){<article class="card"><span class="badge">@(t.State=="Open"?"Em aberto":"Resolvida")</span><h3>@t.Category</h3><p>@t.Description</p><p class="muted small">Pedido: @t.OrderId · @t.At.ToOffset(TimeSpan.FromHours(-3)).ToString("dd/MM/yyyy HH:mm")</p>@if(t.Resolution!=null){<p><strong>Resposta:</strong> @t.Resolution</p>}@if(CanResolve&&t.State=="Open"){<label>Resposta<input @bind="resolution"/></label><button class="quiet" disabled="@Busy" @onclick="()=>Resolve(t.Id)">Resolver solicitação</button>}</article>}@if(tickets?.Total==0){<div class="empty">Nenhuma solicitação registrada.</div>}</div></section>}
@code{string orderId="",category="Ajuda com pedido",description="",resolution="";PageDto<TicketDto>? tickets;bool CanResolve=>Api.Session?.User.Roles.Any(x=>x is "Administrador" or "Suporte")==true;
 protected override async Task OnInitializedAsync(){if(Api.Session!=null)await Load();}async Task Load()=>await Run(async()=>tickets=await Api.Get<PageDto<TicketDto>>("api/support"));
 async Task Create(){if(orderId.Length>0&&!Guid.TryParse(orderId,out _)){Error="Informe um identificador de pedido válido.";return;}await Run(async()=>{await Api.Post<object>("api/support",new TicketInput(orderId.Length==0?null:Guid.Parse(orderId),category,description));description="";Message="Solicitação registrada.";tickets=await Api.Get<PageDto<TicketDto>>("api/support");});}
 async Task Resolve(Guid id){await Run(async()=>{await Api.Post<object>($"api/support/{id}/resolve",new ResolveTicketInput(resolution));tickets=await Api.Get<PageDto<TicketDto>>("api/support");});}}
