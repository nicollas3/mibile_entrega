@page "/admin"
@inherits PageBase
@inject IJSRuntime JS
<PageTitle>Administração · Brasa</PageTitle><p class="eyebrow">A OPERAÇÃO EM BOAS MÃOS</p><h1>Uma visão de cada conexão.</h1><Feedback Error="@Error" Message="@Message" Busy="@Busy"/>
@if(Api.Session?.User.Roles.Contains("Administrador")!=true){<div class="empty">Esta área exige o perfil de administração. <a href="/entrar">Entrar</a></div>}else{
<form class="filters card" @onsubmit="LoadReport" @onsubmit:preventDefault><label>De<input type="date" @bind="from"/></label><label>Até<input type="date" @bind="to"/></label><label>Restaurante<select @bind="reportStore"><option value="">Todos</option>@foreach(var s in stores){<option value="@s.RestaurantId">@s.Name</option>}</select></label><label>Status<select @bind="reportStatus"><option value="">Todos</option><option value="Preparing">Em preparo</option><option value="Delivered">Entregue</option><option value="Cancelled">Cancelado</option></select></label><label>Região<input @bind="region" placeholder="Cidade ou bairro"/></label><label>Pagamento<select @bind="payment"><option value="">Todos</option><option value="demo-approved">Demonstração aprovada</option><option value="demo-pending">Demonstração pendente</option></select></label><button disabled="@Busy">Consultar período</button></form><Stats Report="report"/>
<div class="tabs">@foreach(var t in new[]{"Pedidos","Contas","Entregadores","Restaurantes","Cupons","Operação","Auditoria"}){<button class="@(tab==t?"":"quiet")" @onclick="()=>tab=t">@t</button>}</div>
@if(tab=="Pedidos"){
<div class="table-wrap card"><table><thead><tr><th>Pedido</th><th>Restaurante</th><th>Estado</th><th>Total</th><th>Reembolso</th></tr></thead><tbody>@foreach(var o in orders?.Items??[]){<tr><td><a href="@($"/pedido/{o.Id}")">#@o.Id.ToString()[..8]</a></td><td>@o.RestaurantName</td><td>@Status(o.Status)</td><td>@Money(o.Prices.Total)</td><td>@Status(o.RefundStatus)</td></tr>}</tbody></table></div><div class="actions"><button class="quiet" disabled="@(orderPage<=1||Busy)" @onclick="()=>PageOrders(-1)">Anteriores</button><button class="quiet" disabled="@(orderPage*50>=(orders?.Total??0)||Busy)" @onclick="()=>PageOrders(1)">Próximos</button><a href="/suporte">Central de ocorrências</a></div>
}else if(tab=="Contas"){
<form class="filters" @onsubmit="LoadAccounts" @onsubmit:preventDefault><label>Nome ou email<input @bind="accountQuery"/></label><button disabled="@Busy">Localizar conta</button></form><label>Motivo da ação administrativa<input required @bind="reason"/></label><div class="table-wrap card"><table><thead><tr><th>Conta</th><th>Perfis</th><th>Situação</th><th>Ações</th></tr></thead><tbody>@foreach(var u in accounts?.Items??[]){<tr><td>@u.Name<br/><small>@u.Email</small></td><td>@string.Join(", ",u.Roles)</td><td>@(u.Blocked?"Bloqueada":"Ativa")</td><td><button class="quiet small" disabled="@Busy" @onclick="()=>Block(u)">@(u.Blocked?"Desbloquear":"Bloquear")</button><select aria-label="Perfil para atribuir" @bind="grantRole"><option>Suporte</option><option>Restaurante</option><option>Entregador</option><option>Administrador</option><option>Cliente</option><option>Funcionario</option></select><button class="quiet small" disabled="@Busy" @onclick="()=>Grant(u.Id)">Atribuir perfil</button></td></tr>}</tbody></table></div><div class="actions"><button class="quiet" disabled="@(accountPage<=1||Busy)" @onclick="()=>PageAccounts(-1)">Anteriores</button><button class="quiet" disabled="@(accountPage*50>=(accounts?.Total??0)||Busy)" @onclick="()=>PageAccounts(1)">Próximos</button></div>
}else if(tab=="Entregadores"){
<label>Justificativa da aprovação ou suspensão<input @bind="reason"/></label><div class="grid three">@foreach(var c in couriers){<article class="card"><h3>@c.Name</h3><p>@c.Vehicle · @(c.Available?"Disponível":"Indisponível")</p><span class="badge">@(c.Approved?"Aprovado":"Pendente ou suspenso")</span><button class="quiet" disabled="@Busy" @onclick="()=>Approve(c)">@(c.Approved?"Suspender":"Aprovar")</button></article>}</div>
}else if(tab=="Restaurantes"){
<section class="grid two"><div><h2>Lojas e comissões</h2>@foreach(var s in stores){<article class="card"><h3>@s.Name</h3><p>@s.RestaurantId</p><button class="quiet" @onclick="()=>commissionStore=s.RestaurantId">Ajustar comissão</button></article>}<label>Comissão (fração: 0,12 = 12%)<input type="number" min="0" max="1" step="0.0001" @bind="commission"/></label><label>Motivo<input @bind="reason"/></label><button disabled="@(Busy||commissionStore==Guid.Empty)" @onclick="Commission">Salvar comissão da loja selecionada</button><p><a href="/restaurante">Editar lojas, categorias, cardápios e áreas de atendimento</a></p></div><form class="card form-grid" @onsubmit="NewStore" @onsubmit:preventDefault><h2>Cadastrar restaurante</h2><label>Nome<input required @bind="storeName"/></label><label>Categoria<input required @bind="storeCategory"/></label><label>Endereço<input required @bind="storeAddress"/></label><label>Latitude<input type="number" step="any" @bind="latitude"/></label><label>Longitude<input type="number" step="any" @bind="longitude"/></label><p class="small muted">A loja será criada fechada. Cadastre o cardápio e vincule a equipe pelo painel de restaurante antes de abrir.</p><button disabled="@Busy">Criar loja</button></form></section>
}else if(tab=="Cupons"){
<div class="grid two"><section class="card"><h2>Promoções por cupom</h2>@foreach(var c in coupons){<article class="order-line"><div><strong>@c.Code</strong><p>@Money(c.Discount) · @c.Uses/@c.MaxUses usos · @(c.Active?"Ativo":"Inativo")</p></div><button class="quiet" @onclick="()=>EditCoupon(c)">Editar</button></article>}</section><form class="card form-grid" @onsubmit="SaveCoupon" @onsubmit:preventDefault><h2>Cupom de campanha</h2><label>Código<input required pattern="[A-Z0-9_-]{3,30}" @bind="code"/></label><label>Desconto fixo (R$)<input type="number" min="0.01" step="0.01" @bind="discount"/></label><label>Subtotal mínimo (R$)<input type="number" min="0" step="0.01" @bind="couponMinimum"/></label><label>Validade (UTC)<input type="date" @bind="expiry"/></label><label>Máximo de usos<input type="number" min="1" @bind="maxUses"/></label><label class="inline"><input type="checkbox" @bind="couponActive"/> Ativo</label><button disabled="@Busy">Salvar cupom</button></form></div>
}else if(tab=="Operação"){
<form class="card form-grid settings-form" @onsubmit="SaveSettings" @onsubmit:preventDefault><h2>Prazos e taxas</h2><label>Taxa de serviço (R$)<input type="number" min="0" max="100" step="0.01" @bind="serviceFee"/></label><label>Resposta da loja (min)<input type="number" min="1" max="120" @bind="responseMinutes"/></label><label>Espera por entregador (min)<input type="number" min="1" max="240" @bind="courierMinutes"/></label><label>Prazo de cada oferta (seg)<input type="number" min="15" max="300" @bind="offerSeconds"/></label><button disabled="@Busy">Salvar regras</button><p class="small muted">Pedidos sem resposta são cancelados pelo servidor. Após iniciar o preparo, cancelamentos do cliente exigem suporte. Reembolsos pendentes exigem ação administrativa explícita nesta versão.</p></form>
}else{
<button class="quiet" disabled="@Busy" @onclick="LoadAudit">Atualizar auditoria</button><div class="table-wrap card"><table><thead><tr><th>Quando</th><th>Autor</th><th>Ação</th><th>Recurso / motivo</th></tr></thead><tbody>@foreach(var a in audit){<tr><td>@a.At.ToOffset(TimeSpan.FromHours(-3)).ToString("dd/MM HH:mm:ss")</td><td>@a.ActorId</td><td>@a.Action</td><td>@a.Resource<br/>@a.Reason</td></tr>}</tbody></table></div><div class="actions"><button class="quiet" disabled="@(auditPage<=1||Busy)" @onclick="()=>PageAudit(-1)">Anteriores</button><button class="quiet" disabled="@(audit.Count<50||Busy)" @onclick="()=>PageAudit(1)">Próximos</button></div>}}
@code{
 string tab="Pedidos",region="",payment="",reportStore="",reportStatus="",accountQuery="",reason="",grantRole="Suporte";DateTime from=DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(-3)).Date.AddDays(-30),to=DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(-3)).Date;ReportDto? report;PageDto<OrderDto>? orders;PageDto<AccountDto>? accounts;List<CourierDto> couriers=[];List<CouponDto> coupons=[];List<StoreAccessDto> stores=[];List<AuditDto> audit=[];int orderPage=1,accountPage=1,auditPage=1;
 string code="",storeName="",storeCategory="",storeAddress="";decimal discount=5,couponMinimum=25,commission=.12m,serviceFee=2.5m;int maxUses=100,responseMinutes=10,courierMinutes=30,offerSeconds=90;DateTime expiry=DateTime.Today.AddMonths(1);bool couponActive=true;Guid commissionStore;double latitude=-23.5505,longitude=-46.6333;
 protected override async Task OnInitializedAsync(){if(Api.Session?.User.Roles.Contains("Administrador")!=true)return;await Run(async()=>{stores=await Api.Get<List<StoreAccessDto>>("api/stores");orders=await Api.Get<PageDto<OrderDto>>("api/orders");accounts=await Api.Get<PageDto<AccountDto>>("api/admin/accounts");couriers=await Api.Get<List<CourierDto>>("api/admin/couriers");coupons=await Api.Get<List<CouponDto>>("api/admin/coupons");audit=await Api.Get<List<AuditDto>>("api/admin/audit");var s=await Api.Get<SettingsInput>("api/admin/settings");serviceFee=s.ServiceFee;responseMinutes=s.RestaurantResponseMinutes;courierMinutes=s.CourierWaitMinutes;offerSeconds=s.OfferSeconds;});await LoadReport();}
 async Task LoadReport()=>await Run(async()=>{var start=new DateTimeOffset(DateTime.SpecifyKind(from,DateTimeKind.Unspecified),TimeSpan.FromHours(-3));var end=new DateTimeOffset(DateTime.SpecifyKind(to.AddDays(1).AddTicks(-1),DateTimeKind.Unspecified),TimeSpan.FromHours(-3));report=await Api.Get<ReportDto>($"api/admin/report?from={Uri.EscapeDataString(start.ToString("O"))}&to={Uri.EscapeDataString(end.ToString("O"))}&store={reportStore}&status={reportStatus}&payment={payment}&region={Uri.EscapeDataString(region)}");});
 async Task LoadAccounts()=>await Run(async()=>accounts=await Api.Get<PageDto<AccountDto>>($"api/admin/accounts?page={accountPage}&q={Uri.EscapeDataString(accountQuery)}"));
 async Task Block(AccountDto u){if(!await JS.InvokeAsync<bool>("confirm",$"{(u.Blocked?"Desbloquear":"Bloquear")} esta conta?"))return;await Run(async()=>{await Api.Post<object>($"api/admin/accounts/{u.Id}/block",new BlockInput(!u.Blocked,reason));accounts=await Api.Get<PageDto<AccountDto>>($"api/admin/accounts?page={accountPage}");});}
 async Task Grant(string id){if(!await JS.InvokeAsync<bool>("confirm","Confirmar atribuição do perfil selecionado? A sessão do usuário será encerrada."))return;await Run(async()=>{await Api.Post<object>($"api/admin/accounts/{id}/roles",new RoleInput(grantRole,reason));accounts=await Api.Get<PageDto<AccountDto>>($"api/admin/accounts?page={accountPage}");});}
 async Task Approve(CourierDto c)=>await Run(async()=>{await Api.Post<object>($"api/admin/couriers/{c.UserId}/approval",new ApprovalInput(!c.Approved,reason));couriers=await Api.Get<List<CourierDto>>("api/admin/couriers");});
 void EditCoupon(CouponDto c){code=c.Code;discount=c.Discount;couponMinimum=c.MinimumSubtotal;expiry=c.ExpiresAt.UtcDateTime;maxUses=c.MaxUses;couponActive=c.Active;}
 async Task SaveCoupon()=>await Run(async()=>{await Api.Put<object>("api/admin/coupons",new CouponInput(code,discount,couponMinimum,new DateTimeOffset(DateTime.SpecifyKind(expiry,DateTimeKind.Utc)),maxUses,couponActive));coupons=await Api.Get<List<CouponDto>>("api/admin/coupons");Message="Cupom salvo.";});
 async Task SaveSettings()=>await Run(async()=>{await Api.Put<object>("api/admin/settings",new SettingsInput(serviceFee,responseMinutes,courierMinutes,offerSeconds));Message="Regras atualizadas.";});
 async Task NewStore()=>await Run(async()=>{await Api.Post<object>("api/stores",new RestaurantInput(storeName,"",storeCategory,storeAddress,latitude,longitude,8,"11h–23h","Closed",30,7,15));stores=await Api.Get<List<StoreAccessDto>>("api/stores");Message="Loja criada fechada. Configure equipe e cardápio no painel de restaurante.";});
 async Task Commission()=>await Run(async()=>{await Api.Post<object>($"api/admin/restaurants/{commissionStore}/commission",new CommissionRequest(commission,reason));Message="Comissão atualizada para novos pedidos.";});
 async Task LoadAudit()=>await Run(async()=>audit=await Api.Get<List<AuditDto>>($"api/admin/audit?page={auditPage}"));async Task PageAudit(int delta){auditPage+=delta;await LoadAudit();}async Task PageAccounts(int delta){accountPage+=delta;await LoadAccounts();}async Task PageOrders(int delta){orderPage+=delta;await Run(async()=>orders=await Api.Get<PageDto<OrderDto>>($"api/orders?page={orderPage}"));}
}
