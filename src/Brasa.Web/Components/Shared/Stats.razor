@if(Report!=null){<div class="grid four stats"><div class="card"><span>Pedidos no período</span><strong>@Report.Orders</strong><small>@Report.Active em andamento</small></div><div class="card"><span>Volume pago (demo)</span><strong>@Money(Report.GrossSales)</strong><small>Reembolsos: @Money(Report.Refunds)</small></div><div class="card"><span>Restaurante / entregas</span><strong>@Money(Report.RestaurantAmount)</strong><small>Entregadores: @Money(Report.CourierAmount)</small></div><div class="card"><span>Comissão / serviço</span><strong>@Money(Report.Commission)</strong><small>Serviço: @Money(Report.ServiceFees) · @Report.Cancelled cancelados</small></div></div>}
@code{[Parameter]public ReportDto? Report{get;set;}}
